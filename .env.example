# Supabase-Projekt-URL (Supabase → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlicher Anon-Key (Supabase → Project Settings → API Keys → anon/public).
# Landet im Browser; darf per RLS nur lesen.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-Role-Key (Supabase → Project Settings → API Keys → service_role).
# GEHEIM – nur auf dem Server, niemals mit NEXT_PUBLIC_ präfixen.
SUPABASE_SERVICE_ROLE_KEY=

# Gemeinsames Passwort für die Login-Seite
APP_PASSWORD=

# Zufälliger Schlüssel (mind. 32 Zeichen) zum Signieren des Session-Cookies,
# z. B. erzeugen mit: openssl rand -base64 48
# Ändern meldet alle Geräte ab.
SESSION_SECRET=
